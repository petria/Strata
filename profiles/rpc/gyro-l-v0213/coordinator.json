{
  "exe": "$RPC_ENGINE",
  "args": [
    "--pack",
    "$MODEL_DATA_ROOT/packs/gyro-l",
    "--native",
    "$MODEL_DATA_ROOT/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-TQ3_0.gguf",
    "--ple-gguf",
    "$MODEL_DATA_ROOT/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-TQ3_0.gguf",
    "--expert-profile",
    "$STRATA_ROOT/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "2048",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "$MODEL_DATA_ROOT/mtp/rt",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--resident-experts",
    "--vram-reserve-mib",
    "1000",
    "--rpc-prefix-layers",
    "24",
    "--rpc-model-id",
    "5428a5646eaeaa56cc00a892f92e7546aeadb255233503969ad25cf48c7f359b",
    "--rpc-ca",
    "$TLS_DIR/ca.crt",
    "--conversation-cache-mib",
    "8192",
    "--conversation-cache-slots",
    "4",
    "--rpc-stage",
    "$RPC_STAGE_ADDRESS",
    "--rpc-cert",
    "$TLS_DIR/strata-stage-coordinator.crt",
    "--rpc-key",
    "$TLS_DIR/strata-stage-coordinator.key",
    "--vision",
    "--rpc-transport",
    "tcp"
  ],
  "cwd": "$STRATA_ROOT",
  "tokenizer": "$MODEL_DATA_ROOT/packs/gyro-l/tokenizer",
  "model_name": "qwen3.8-flash-next-gyro-l-tq3_0-v0.2.13-rpc",
  "log": "$STATE_DIR/engine.log",
  "lib_dirs": [
    "$RPC_CUDA_BIN",
    "$RPC_CUDA_LIB"
  ],
  "port": 8080,
  "gpu": 0,
  "gpus_asked": true,
  "host": "0.0.0.0",
  "api_key": "none",
  "open_browser": false,
  "reasoning_effort": "low",
  "tool_call_recovery": true,
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.05,
    "repetition_penalty": 1.0
  },
  "vision": {
    "exe": "$STRATA_ROOT/engine/strata-vision",
    "mmproj": "$MODEL_DATA_ROOT/models/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "$MODEL_DATA_ROOT/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-TQ3_0.gguf",
    "gpu": false,
    "max_tokens": 1024
  },
  "env": {
    "STRATA_RPC_PROFILE": "1",
    "STRATA_RPC_MONITOR_REMOTE_GPU": "1",
    "STRATA_LOOKUP_MAX_T": "0",
    "STRATA_VERIFY_TRACE": "1",
    "STRATA_VERIFY_DEBUG": "1",
    "STRATA_VERIFY_PROFILE": "1",
    "STRATA_DEBUG": "1",
    "STRATA_BATCH_TRACE": "1",
    "STRATA_RSS_TRACE": "1",
    "STRATA_TRACE_ADAPT": "1",
    "STRATA_LAUNCH_PROBE": "1",
    "STRATA_DRAFT_LOG": "1",
    "PYTHONUNBUFFERED": "1",
    "PYTHONFAULTHANDLER": "1",
    "STRATA_TRACE": "2",
    "STRATA_CUDA_DOORBELL_MODE": "store"
  },
  "aliases": [
    "local-strata"
  ],
  "split_engine": "off",
  "drafting": "mtp"
}
