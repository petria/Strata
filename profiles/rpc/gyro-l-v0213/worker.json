    "STRATA_VERIFY_PROFILE": "1",
    "STRATA_DEBUG": "1",
    "STRATA_BATCH_TRACE": "1",
    "STRATA_RSS_TRACE": "1",
    "STRATA_TRACE_ADAPT": "1",
    "STRATA_LAUNCH_PROBE": "1",
    "STRATA_DRAFT_LOG": "1",
    "PYTHONUNBUFFERED": "1",
    "PYTHONFAULTHANDLER": "1",
    "STRATA_TRACE": "2",
    "STRATA_CUDA_DOORBELL_MODE": "increment"
