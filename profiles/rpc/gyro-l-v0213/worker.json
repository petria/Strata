{
  "exe": "$RPC_ENGINE",
  "args": [
    "--pack",
    "$MODEL_DATA_ROOT/packs/gyro-l",
    "--native",
    "$MODEL_DATA_ROOT/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-TQ3_0.gguf",
    "--ple-gguf",
    "$MODEL_DATA_ROOT/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-TQ3_0.gguf",
    "--expert-profile",
    "$STRATA_ROOT/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "2048",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--resident-experts",
    "--vram-reserve-mib",
    "4096",
    "--rpc-prefix-layers",
    "24",
    "--rpc-model-id",
    "5428a5646eaeaa56cc00a892f92e7546aeadb255233503969ad25cf48c7f359b",
    "--rpc-ca",
    "$TLS_DIR/ca.crt",
    "--conversation-cache-mib",
