    "4",
    "--vision",
    "--rpc-transport",
    "tcp",
    "--ple-io",
    "ram",
    "--rpc-listen",
    "192.0.2.20:50056",
    "--rpc-allow-peer",
    "192.0.2.10",
    "--rpc-cert",
    "$TLS_DIR/strata-stage-worker.crt",
    "--rpc-key",
    "$TLS_DIR/strata-stage-worker.key",
    "--pool-workers",
    "12",
    "--serve"
