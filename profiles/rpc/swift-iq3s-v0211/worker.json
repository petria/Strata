{
  "exe": "$STRATA_ROOT/build-v0211-sm86-rdma/strata",
  "args": [
    "--pack",
    "$MODEL_DATA_ROOT/packs/swift-iq3_s",
    "--native",
    "$MODEL_DATA_ROOT/models/swift-IQ3_S/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf",
    "$MODEL_DATA_ROOT/models/swift-IQ3_S/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--expert-profile",
    "$STRATA_ROOT/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "2048",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--resident-experts",
    "--vram-reserve-mib",
    "4096",
    "--rpc-prefix-layers",
    "24",
    "--rpc-model-id",
    "ada301f193f3aa71d02bc8f0a006210e064c23afb1258069df0f3cb824a48cec",
    "--rpc-ca",
    "$TLS_DIR/ca.crt",
    "--conversation-cache-mib",
    "8192",
