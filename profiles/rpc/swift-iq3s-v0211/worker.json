  "cwd": "$STRATA_ROOT",
  "env": {
    "STRATA_RESIDENT_HEADROOM_GIB": "8",
    "STRATA_MMQ_KQ": "1",
    "STRATA_RPC_PROFILE": "1",
    "STRATA_RPC_MONITOR_REMOTE_GPU": "1",
    "STRATA_LOOKUP_MAX_T": "0",
    "STRATA_VERIFY_TRACE": "1",
    "STRATA_VERIFY_DEBUG": "1",
    "STRATA_VERIFY_PROFILE": "1",
    "STRATA_DEBUG": "1",
    "STRATA_BATCH_TRACE": "1",
    "STRATA_RSS_TRACE": "1",
    "STRATA_TRACE_ADAPT": "1",
    "STRATA_LAUNCH_PROBE": "1",
    "STRATA_DRAFT_LOG": "1",
    "PYTHONUNBUFFERED": "1",
    "PYTHONFAULTHANDLER": "1",
    "STRATA_TRACE": "2",
    "STRATA_CUDA_DOORBELL_MODE": "increment"
  }
}
