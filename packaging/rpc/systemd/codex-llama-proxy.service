# Template: render with tools/rpc/stack_manage.py render before installation.
[Unit]
Description=Strata RPC proxy
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@WORKING_DIRECTORY@
@ENVIRONMENT@
ExecStart=@EXEC_START@
Restart=always
RestartSec=3
LimitNOFILE=65536
StandardOutput=@STDOUT@
StandardError=@STDERR@

[Install]
WantedBy=default.target
