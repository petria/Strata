# Template: render with tools/rpc/stack_manage.py render before installation.
[Unit]
Description=Strata RPC coordinator
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@WORKING_DIRECTORY@
@ENVIRONMENT@
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
LimitNOFILE=65536
StandardOutput=@STDOUT@
StandardError=@STDERR@

[Install]
WantedBy=default.target
